# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (required in production — httpOnly session signing)
AUTH_SECRET=replace-with-a-long-random-string

# Phase E — Admin bootstrap (creates/promotes this account on first login)
ADMIN_EMAIL=admin@redline.local
ADMIN_PASSWORD=change-me-admin

# Phase C — Commerce
# Leave Stripe empty to use local demo checkout (creates paid orders + decrements stock).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=REDLINE <onboarding@resend.dev>

# Phase E+ — Postgres
# When set, catalog/orders/users/inventory use Drizzle + Postgres.
# When unset, local JSON under web/.data/ is used (product CRUD still works).
#
# Local (Docker Compose from repo root: docker compose up -d):
DATABASE_URL=postgresql://redline:redline@localhost:5434/shoe_showcase
#
# Hosted (Neon etc.):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# After setting DATABASE_URL:
#   npm run db:push
#   npm run db:seed
